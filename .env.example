# ---- Database ----
# MongoDB connection string (Prisma `mongodb` provider).
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority"

# ---- NextAuth ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# OAuth providers (https://console.cloud.google.com / https://github.com/settings/developers)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""

# ---- Admin dashboard (/admin) ----
# All three are required. If any is missing — or the session secret is shorter
# than 32 characters — isAdminConfigured() returns false and /admin is disabled
# (POST /api/admin/session responds 503).
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
# Must be at least 32 characters. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=""

# ---- Site / SEO ----
# Absolute public origin, no trailing slash. Required for metadataBase, canonical
# URLs, sitemap.xml and robots.txt. Social scrapers reject relative OG URLs, so
# this must be set in every deployed environment.
NEXT_PUBLIC_SITE_URL="https://snapify.lk"
