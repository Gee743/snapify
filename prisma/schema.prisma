// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts Account[]
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

enum SpaceCategory {
  BEACH
  WATERFALL
  VIEWPOINT
  TEMPLE_LANDMARK
  NATURE_TRAIL
  URBAN
}

enum DroneRule {
  ALLOWED
  PERMIT_REQUIRED
  PROHIBITED
  UNKNOWN
}

enum SpaceStatus {
  PUBLISHED
  PENDING
  REJECTED
}

enum StudioType {
  DAYLIGHT
  BLACKOUT
  CYCLORAMA
  VILLA
  ROOFTOP
  WAREHOUSE
  HERITAGE
  EVENT_VENUE
}

enum StudioStatus {
  PUBLISHED
  PENDING
  REJECTED
}

model PublicSpace {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  slug          String   @unique
  name          String
  type          String
  locationLabel String
  latlng        Float[]
  description   String
  directions    String
  tips          String[]
  imageSrc      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Structured location. locationLabel stays for display and back-compat, but
  // these are what the hub URLs, JSON-LD address and breadcrumbs read from.
  // String parsing is fragile: an admin entering "Ella" with no comma would
  // make city and province identical.
  city         String?
  citySlug     String?
  district     String?
  districtSlug String?
  province     String?
  provinceSlug String?

  // Controlled taxonomy for the category hubs. The freeform `type` field stays
  // as the human-readable descriptor, e.g. "Clifftop Temple".
  category SpaceCategory?

  // Gallery. imageSrc remains the canonical hero so OG/JSON-LD stay unambiguous.
  images String[]

  // Shoot timing. bestMonths is 1-12 and matters a lot here: the west/south
  // coast is effectively unshootable May-Sept, the east Nov-Feb.
  bestTimeOfDay String[]
  bestMonths    Int[]
  shootingNotes String?

  // Access intelligence -- the differentiator. Sri Lanka's shoot-permission
  // landscape is split across the NFC, Dept. of Archaeology, Central Cultural
  // Fund, CAASL/TRCSL and the Galle Heritage Foundation.
  entryFee        String?
  isFree          Boolean   @default(true)
  permitRequired  Boolean   @default(false)
  permitAuthority String?
  permitNotes     String?
  droneRule       DroneRule @default(UNKNOWN)
  droneNotes      String?
  openingHours    String?
  tripodAllowed   Boolean?

  // Per-place SEO overrides.
  metaTitle       String?
  metaDescription String?

  // Submission pipeline.
  status           SpaceStatus @default(PUBLISHED)
  submittedByName  String?
  submittedByEmail String?

  // Provenance for imported places (OSM/ODbL and Wikimedia attribution).
  sourceAttribution String?

  @@index([citySlug])
  @@index([districtSlug])
  @@index([provinceSlug])
  @@index([category])
  @@index([status])
}

/// A paid, bookable space: a studio, villa, rooftop or warehouse an owner rents
/// out for shoots. Deliberately a separate model from PublicSpace rather than a
/// `kind` discriminator on it -- the two share almost no decision-making fields.
/// A studio has no permit authority, drone rule or golden hour; a public space
/// has no rate card, capacity or owner. One model would leave roughly a dozen
/// columns null on every row in both directions and make validation conditional.
model Studio {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  slug    String @unique
  name    String
  tagline String
  /// Freeform human descriptor, mirroring PublicSpace.type ("Daylight loft").
  type        String
  description String

  /// Same structured-location contract as PublicSpace, so the two can share the
  /// slugify/hub helpers and a studio can be placed on the same area pages.
  locationLabel String
  city          String?
  citySlug      String?
  district      String?
  districtSlug  String?
  province      String?
  provinceSlug  String?
  /// Optional: an owner may not want an exact pin published pre-booking.
  latlng Float[]

  imageSrc String
  images   String[]

  studioType StudioType @default(DAYLIGHT)

  /// Rates are stored as integers in minor-unit-free LKR (rupees), not strings,
  /// because the index page sorts and filters on them. A null rate means "ask"
  /// rather than zero -- zero would sort as the cheapest studio on the site.
  currency      String  @default("LKR")
  hourlyRate    Int?
  halfDayRate   Int?
  fullDayRate   Int?
  minimumHours  Int?
  rateNotes     String?

  /// Capacity and dimensions, the other half of the shortlist decision.
  capacity       Int?
  floorAreaSqft  Int?
  ceilingHeightFt Int?

  amenities String[]
  equipment String[]

  /// Availability as prose. Deliberately not a booking calendar: enquiries go
  /// to the owner, and a stale calendar is worse than none.
  availabilityNotes String?
  openingHours      String?

  /// Owner contact. Never rendered publicly -- enquiries route through
  /// SpaceInquiry so the address is not scraped off the page.
  ownerName  String?
  ownerEmail String?
  ownerPhone String?

  bookingNotes       String?
  cancellationPolicy String?

  metaTitle       String?
  metaDescription String?

  status StudioStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([citySlug])
  @@index([districtSlug])
  @@index([provinceSlug])
  @@index([studioType])
  @@index([status])
}

model SpaceOwnerLead {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String
  phone        String?
  spaceName    String?
  locationText String?
  spaceType    String?
  message      String?
  createdAt    DateTime @default(now())

  @@index([email])
}

/// An enquiry about a bookable studio. `spaceSlug` holds the Studio slug; the
/// field keeps its original name so the existing admin leads inbox and its
/// SpaceInquiryRecord type keep working unchanged.
model SpaceInquiry {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  spaceSlug String
  name      String
  email     String
  phone     String?
  shootDate DateTime?
  message   String?
  /// Denormalised so the inbox can show what was enquired about without a
  /// second lookup, and still reads correctly if the studio is later renamed.
  spaceName String?
  crewSize  Int?
  createdAt DateTime  @default(now())

  @@index([spaceSlug])
}

model NewsletterSubscriber {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())
}

model PublicSpaceBootstrap {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  key       String  @unique
  completed Boolean @default(false)
}
